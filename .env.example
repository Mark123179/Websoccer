# =============================================================
# Websoccer — Environment template (PRODUCTION / Hetzner)
#
# Commit THIS file (.env.example) only. NEVER commit the real .env —
# it stays server-local under /opt/websoccer/.env and is gitignored.
# Copy it once on a fresh server:  cp .env.example .env  (then fill in).
# =============================================================

# --- Django core ---
# Generate a strong key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
# Production MUST be False. With DEBUG=False, SECRET_KEY is required.
DEBUG=False
# Comma-separated. Pin to the server IP and/or domain.
ALLOWED_HOSTS=49.13.5.151
# Optional, comma-separated, full scheme. Needed once you add a domain/HTTPS.
# CSRF_TRUSTED_ORIGINS=https://example.com
# HTTP-only deploy must keep cookies non-Secure or login breaks.
# Set to True together with ENABLE_HTTPS once HTTPS is in place (see below).
COOKIE_SECURE=False

# --- HTTPS / TLS (Let's Encrypt) ---
# A real domain (DNS A-record -> this server) is REQUIRED — Let's Encrypt
# cannot issue certificates for a bare IP. Used for nginx server_name and the
# certificate paths.
DOMAIN=
# Email address for Let's Encrypt expiry notifications.
CERTBOT_EMAIL=
# Use Let's Encrypt staging (test) certs while testing to avoid rate limits.
# Set to 1 for first dry runs, then back to 0 for the real certificate.
CERTBOT_STAGING=0
# Master switch for Django HTTPS hardening (SSL redirect, HSTS, proxy SSL
# header). Turn on ONLY after certificates are active; also set COOKIE_SECURE=True.
ENABLE_HTTPS=False

# --- Database (Django reads DATABASE_URL) ---
# Host "db" matches the compose service name.
DATABASE_URL=postgres://websoccer:change-me@db:5432/websoccer
# Used by the Postgres container to initialise the database.
POSTGRES_DB=websoccer
POSTGRES_USER=websoccer
POSTGRES_PASSWORD=change-me

# --- Redis (prepared for cache / Celery; not actively used in V1) ---
REDIS_URL=redis://redis:6379/0

# --- Media storage ---
# Keep OFF on the self-hosted server (uses local filesystem + nginx).
REPLIT_OBJECT_STORAGE=0

# --- Optional: auto-run migrate + collectstatic on container start ---
# Leave 0 in production and run migrations manually (recommended).
RUN_MIGRATIONS=0

# --- External API secrets (set real values on the server only) ---
# CMTracker LIVE key is IP-locked: it works ONLY from the registered server IP
# (49.13.5.151). Set it exclusively in this server-local .env; never commit it.
# Calls from unregistered IPs (e.g. the Replit dev env) return HTTP 401 by design.
CMTRACKER_API_KEY=
OPENAI_API_KEY=
