# =============================================================
# Websoccer — nginx reverse proxy (production, HTTPS)
#
# This file is a TEMPLATE rendered by nginx/docker-entrypoint.sh via
# envsubst on container start. Only ${DOMAIN} is substituted; nginx
# runtime vars like $host are left untouched.
#
# The entrypoint only renders this file when a valid TLS certificate
# already exists at /etc/letsencrypt/live/${DOMAIN}/fullchain.pem.
# Before the first cert is issued, nginx/bootstrap.conf (HTTP-only) is
# used instead so the ACME challenge can be answered.
#
# Port 80: ACME HTTP-01 challenge + redirect to HTTPS.
# Port 443: TLS termination, /static + /media from disk, everything
#           else proxied to the Gunicorn web container.
#
# Certificates are issued/renewed by the certbot service and
# bootstrapped once via init-letsencrypt.sh.
# =============================================================

upstream websoccer_web {
    server web:8000;
}

# ---- HTTP: ACME challenge + redirect to HTTPS ----
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge (served directly, never redirected).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else is redirected to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS: the actual application ----
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Allow large-ish uploads (avatars etc.)
    client_max_body_size 10M;

    # Bild-Assets (Spielergesichter, Club-Logos, Trophäen …) direkt von
    # der Platte (Bind-Mount /var/www/assets → /app/assets). Die App baut
    # die URLs nur als Strings (ASSETS_BASE_URL=/assets/) — fehlende
    # Dateien beantwortet nginx mit 404, der Client zeigt den Platzhalter.
    location /assets/ {
        alias /app/assets/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /app/media/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://websoccer_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
